#!/bin/bash
set -uo pipefail

# Smart cd into a dir under ~/workspace or ~/docs.
#    cdo [pattern]
# Pattern is plain text or regex (case-insensitive), matched on the dir name.
# Match ranking (highest non-empty tier wins):
#    1. exact name
#    2. prefix
#    3. infix
#    4. regex
# Multiple matches: prints a numbered list; pick a number, or type a new
# pattern to refine within the current matches.
#
# This script PRINTS the chosen path on stdout. It cannot change the
# parent shell's directory itself. Source a wrapper in your shell rc:
#
#    cdo() { local d; d=$(command cdo "$@") || return; [ -n "$d" ] && cd "$d"; }

ROOTS=("$HOME/docs" "$HOME/workspace")

err() { printf '%s\n' "$*" >&2; }

if [[ $# -lt 1 ]]; then
    err "usage: cdo <pattern>"
    exit 2
fi

cur=$(mktemp /tmp/cdo_cur.XXXXXX)
nxt=$(mktemp /tmp/cdo_nxt.XXXXXX)
trap 'rm -f "$cur" "$nxt"' EXIT

# Prefer /dev/tty so prompts work even when stdout is captured via $().
# Fall back to stdin if /dev/tty isn't usable (piped input, sandbox, etc.).
if (: </dev/tty) 2>/dev/null; then
    use_tty=1
else
    use_tty=0
fi
read_input() {
    if (( use_tty )); then
        IFS= read -r "$1" </dev/tty
    else
        IFS= read -r "$1"
    fi
}

# Seed: full paths of all direct subdirs of each root, in root order.
for r in "${ROOTS[@]}"; do
    for d in "$r"/*/; do
        [[ -d $d ]] && printf '%s\n' "${d%/}"
    done
done > "$cur"

# filter <query> <src_file> <dst_file>
# Picks the highest non-empty tier of matches.
filter() {
    local query="$1" src="$2" dst="$3"
    local lower_q
    lower_q=$(printf '%s' "$query" | tr '[:upper:]' '[:lower:]')

    # shellcheck disable=SC2016  # awk program, not shell
    local base='{ k=split($0, p, "/"); n=tolower(p[k]) }'

    # tier 1: exact (case-insensitive)
    awk -v q="$lower_q" "$base"' n==q' "$src" > "$dst"
    [[ -s $dst ]] && return

    # tier 2: prefix
    awk -v q="$lower_q" "$base"' index(n, q)==1' "$src" > "$dst"
    [[ -s $dst ]] && return

    # tier 3: infix
    awk -v q="$lower_q" "$base"' index(n, q)>0' "$src" > "$dst"
    [[ -s $dst ]] && return

    # tier 4: regex (extended, case-insensitive)
    awk -v q="$lower_q" "$base"' n ~ q' "$src" > "$dst" 2>/dev/null || true
}

query="$1"
filter "$query" "$cur" "$nxt"
mv "$nxt" "$cur"

while true; do
    n=$(wc -l < "$cur" | tr -d ' ')
    if [[ $n == "0" ]]; then
        err "no dir matches: $query"
        exit 1
    elif [[ $n == "1" ]]; then
        head -n1 "$cur"
        exit 0
    else
        err ""
        err "multiple matches:"
        i=0 tilde="~"
        while IFS= read -r path; do
            i=$((i+1))
            err "  $i) ${path/#$HOME/$tilde}"
        done < "$cur"
        err ""
        printf 'Pick number or new pattern: ' >&2
        if ! read_input input; then
            err "cancelled"
            exit 1
        fi
        if [[ -z $input ]]; then
            err "cancelled"
            exit 1
        fi
        if [[ $input =~ ^[0-9]+$ ]]; then
            idx=$input
            if (( idx >= 1 && idx <= n )); then
                sed -n "${idx}p" "$cur"
                exit 0
            else
                err "invalid number"
                continue
            fi
        fi
        query="$input"
        filter "$query" "$cur" "$nxt"
        mv "$nxt" "$cur"
    fi
done
